# the server's domain name (an A record pointing at this server's IP), e.g. scp.example.com or name.duckdns.org
SCP_DOMAIN=scp.example.com
# for Let's Encrypt notices about the certificate
SCP_EMAIL=you@example.com
# the app logs in with these; any long random password
SCP_USER=scplayer
SCP_PASS=change-me-to-a-long-random-string
