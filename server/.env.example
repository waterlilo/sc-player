# Copy to .env on the server and fill in. Never commit .env.

# The server's name. With no domain of your own, sslip.io gives one for the IP: 203.0.113.5 -> 203-0-113-5.sslip.io
SCP_DOMAIN=203-0-113-5.sslip.io

# the built-in proxy's login (goes into proxy.local.json when building the app)
SCP_USER=scp
SCP_PASS=change-me-to-a-long-random-string
# the made-up name the proxy asks for the password on (anyone else sees an ordinary site): openssl rand -hex 12, then .invalid
SCP_SECRET_HOST=0123456789abcdef01234567.invalid

# moderation of the workshop (curl -H "Authorization: Admin <token>" .../v1/admin/themes); 24+ characters
ADMIN_TOKEN=change-me-to-another-long-random-string

# sc player accounts: the pepper the server mixes into every account's login hash (32+ characters: openssl rand -hex 32).
# Back it up apart from the database. Lost, nobody signs in by password any more (recovery codes still work); leaked
# together with the database, passwords can be guessed offline (slowly: Argon2id).
SCP_ACCOUNT_PEPPER=change-me-to-64-random-hex-characters-0123456789abcdef0123456789ab
